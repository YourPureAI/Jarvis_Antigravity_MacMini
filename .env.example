# LLM Provider Configuration
# Active provider: "macmini" (Local Mac Mini LM Studio) or "gemini" (Google Gemini API)
LLM_PROVIDER=macmini

# Google Gemini API
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# Local Mac Mini (LM Studio on LAN)
MACMINI_BASE_URL=http://192.168.1.100:1234/v1
MACMINI_MODEL=nvidia-nemotron-3.5-bolt-e4b-mlx
MACMINI_API_KEY=lm-studio

